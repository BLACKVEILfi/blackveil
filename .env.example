# Copy to .env and adjust. All values are optional; defaults are shown.
PORT=9150
HOST=127.0.0.1
# PUBLIC=1 hides internal paths starting with /_ (set this on a public server)
PUBLIC=1
# RPC for reads
RPC_URL=https://robinhood-rpc.publicnode.com
# Indexer poll interval in ms
SYNC_MS=4000
# Local fork only:
# LOCAL_RPC=http://127.0.0.1:8545
# BANK=0x...
# DEPLOY_BLOCK=0
